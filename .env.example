# Agrikural AI System Configuration

# Database: PostgreSQL (or SQLite fallback: sqlite+aiosqlite:///./data/agrikural.db)
DATABASE_URL=sqlite+aiosqlite:///./data/agrikural.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/agrikural

# JWT Security
JWT_SECRET=agrikural-secure-jwt-secret-key-2026-production-salt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ChromaDB Vector Store
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=agriculture_knowledge
TOP_K=5

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM Reasoning Engine
LLM_PROVIDER=local
LLM_MODEL=agrikural-grounded-reasoner-v1
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

# Speech-to-Text (STT) - Tamil, Malayalam, English
STT_PROVIDER=local
STT_MODEL=whisper-base-multilingual

# Translation (Tamil/Malayalam <-> English)
TRANSLATION_PROVIDER=local
TRANSLATION_MODEL=indic-trans-multilingual

# Text-to-Speech (TTS)
TTS_PROVIDER=gtts
TTS_MODEL=indic-tts

# Hardware Gateway
SIMULATOR_INTERVAL_SECONDS=3.0
GATEWAY_SECRET=agrikural-hardware-gateway-secret-token
